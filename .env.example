# ---- Banco de dados (Supabase / Postgres, região São Paulo) ----
# Connection string do Postgres. No Supabase: Project Settings > Database > Connection string (URI).
DATABASE_URL="postgresql://postgres:[SENHA]@db.[PROJECT].supabase.co:5432/postgres"

# ---- Supabase Storage (issues #5/#24 — imagens dos reports/galeria) ----
# Project Settings > API. A service role key é SÓ de servidor — nunca exponha.
SUPABASE_URL="https://[PROJECT].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Auth.js v5 ----
# Gere com: npx auth secret
AUTH_SECRET=""
# Em produção, a URL pública do site (ex.: https://seudominio.com)
AUTH_URL="http://localhost:3000"

# ---- Credenciais iniciais do seed (npm run db:seed) ----
# Usadas só para criar as contas iniciais. Troque após o primeiro login.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-admin"
PLAYER_PASSWORD="change-me-player"

# ---- IA (Fase 3 — assistente de regras RAG) ----
# Use APENAS no servidor. Nunca exponha no cliente.
# Geração das respostas (Claude):
ANTHROPIC_API_KEY=""
ASSISTANT_MODEL="claude-haiku-4-5"
# Limite diário de perguntas por usuário logado (issue #13) — protege o custo
# de API. Opcional: default 10 se não definido.
ASSISTANT_DAILY_MESSAGE_LIMIT="10"
# Embeddings (busca semântica) — OpenAI:
OPENAI_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"
