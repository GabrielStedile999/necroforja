# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# lixeira local do fluxo Cowork (a ponte não deleta arquivos, só move) —
# precisa estar ignorada: o Tailwind v4 escaneia todo arquivo não-gitignorado
# e caches binários aqui dentro geram classes corrompidas no globals.css
/_to_delete

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (NUNCA commitar segredos)
.env
.env*.local
.env.production
.mcp.json

# vercel
.vercel

# typescript
*.tsbuildinfo

# drizzle
/drizzle/meta

# testes
/coverage

# Playwright (issue #27)
/test-results
/playwright-report
/blob-report
/playwright/.cache

# texto integral dos livros (IP — não redistribuir). Uso local/privado.
/content/books

# Private rule content & tooling (issue #67) — never commit rule data or the
# extraction script; content lives only in the database (import via
# /admin/catalog). Covers *.private.json, *.draft.private.json, *.private.mjs.
*.private.*
